
{
  "expo": {
    "name": "FortunaMobile",
    "slug": "FortunaMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fortuna-globe.png",
    "scheme": "fortunamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fortunaglobalsupplychain.FortunaMobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fortunaglobalsupplychain.FortunaMobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fortuna-globe.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18bdeac7-271a-4301-8ebe-f802278f06d6"
      }
    }
  }
}
